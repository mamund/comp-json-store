{
  "name": "@mamund/comp-json-store",
  "version": "0.1.0",
  "description": "Local JSON document store with journaled, compensable operations",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./helpers/set-fields": "./src/helpers/set-fields.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:consumer": "node scripts/consumer-smoke.mjs"
  },
  "keywords": [
    "json",
    "store",
    "compensation",
    "saga",
    "journal"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamund/comp-json-store.git"
  },
  "homepage": "https://github.com/mamund/comp-json-store#readme",
  "bugs": {
    "url": "https://github.com/mamund/comp-json-store/issues"
  }
}
